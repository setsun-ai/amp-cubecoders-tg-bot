# /etc/amp-tg-bot.env  (chmod 600, wlasciciel root)
TG_TOKEN=123456789:token-od-BotFathera
TG_CHAT_ID=123456789
# zarzadzanie serwerami (/servers) - osobne konto AMP dla bota, bez 2FA:
# AMP_URL=http://127.0.0.1:8080
# AMP_USER=telegrambot
# AMP_PASS=...
# AMP_NOTIFY=1                  # zadania AMP z postepem i zmiany stanu serwerow; 0 = wylaczone
# opcjonalnie:
# BOT_LANG=pl                     # domyslny jezyk: pl, en, ru, uk (zmiana na czacie: /lang)
# TG_ADMINS=123456789,987654321   # kto moze uzywac komend (domyslnie TG_CHAT_ID)
# TG_FRIENDS_TOKEN=...            # osobny bot dla znajomych (od BotFathera); glowny jest wtedy tylko twoj
# DOTA_CHECK_MINUTES=60           # mecze Doty (OpenDota) co tyle minut; 0 = wylaczone
# UPDATES_CHECK_HOURS=6           # sam pisze o waznych aktualizacjach systemu i AMP; 0 = wylaczone
# RETENTION_DAYS=180              # jak dlugo trzymac historie graczy
# TEMP_ALERT=85                   # alert temperatury CPU (C)
# BATTERY_WARN=45                 # alert, gdy bateria spadnie ponizej (%), 0 = wylaczony
# PLAYIT_SERVICE=playit           # nazwa uslugi playit.gg
# WEEKLY_DAY=6                    # podsumowanie tygodnia: 0 = pon ... 6 = niedziela
# WEEKLY_HOUR=20
# WARN_SECONDS=60                 # ostrzezenie graczy w grze przed stop/restart/aktualizacja; 0 = od razu
# CRASH_RESTART=0                 # 1 = po padnieciu gry jeden automatyczny start (drugi raz w 30 min - tylko alert)
# AC_ALERT=1                      # alert, gdy laptop przejdzie na baterie; 0 = wylaczony
# DISK_WARN_GB=10                 # alert, gdy na dysku zostanie mniej GB; 0 = wylaczony
# MOD_CHECK_HOURS=12              # nowe wersje modow (Modrinth, Thunderstore); 0 = wylaczone
# GAME_CHECK_HOURS=3              # nowe wersje gier (Steam, Minecraft vanilla); 0 = wylaczone
# GAME_AUTO_UPDATE=0              # 1 = aktualizuj gre sam, gdy nikt nie gra
# MEM_WARN=95                     # alert, gdy serwer gry zajmie tyle % swojej pamieci; 0 = wylaczony
# HC_URL=https://hc-ping.com/...  # healthcheck: bot pinguje sam (zamiast skryptu w cronie); /fail, gdy AMP nie odpowiada
# HC_MINUTES=5                    # co ile minut ping
